# Local development defaults. For production use scripts/generate_production_env.py
# and DEPLOYMENT.md instead — never deploy this file as-is.

# Application
APP_NAME=Global Commerce ERP
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-at-least-64-chars
API_V1_PREFIX=/api/v1
TIMEZONE=UTC
CURRENCY=USD
CURRENCY_SYMBOL=$
# Base country of the deployment: domestic vs international delivery, fallback store country
STORE_COUNTRY=US
ORDER_NUMBER_PREFIX=ORD
# Writable folder for uploads/invoices; empty = <repo>/uploads
UPLOAD_ROOT=

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=global_ecommerce_erp
MONGODB_MAX_POOL_SIZE=100

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=15
ADMIN_REFRESH_TOKEN_EXPIRE_DAYS=1

# 2FA (TOTP)
TOTP_ISSUER=Global-ERP
TOTP_DIGITS=6
TOTP_INTERVAL=30
MAX_2FA_ATTEMPTS=5
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Rate limiting (production requires a shared Redis store)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_STORAGE_URI=
REDIS_URL=redis://localhost:6379/0
# Set true only behind a proxy you control that overwrites X-Forwarded-For
TRUST_PROXY_HEADERS=false

# CORS / host validation
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=
MAX_REQUEST_BODY_BYTES=12582912

# Online payments — code-ready but intentionally not offered at checkout until
# real provider credentials and callback testing are in place. COD needs none.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASE_URL=https://api.stripe.com/v1
# Shared secret for gateway callbacks (HMAC-SHA256 over the raw body,
# sent as X-Payment-Signature). Empty disables callbacks.
PAYMENT_CALLBACK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Bangladesh payments (enable for BD deployments; configure in admin settings too)
BKASH_API_KEY=
BKASH_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

NAGAD_MERCHANT_ID=
NAGAD_API_KEY=
NAGAD_BASE_URL=

ROCKET_MERCHANT_ID=
ROCKET_API_KEY=

# Transactional email (optional). With SMTP_HOST empty, order emails are skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
SUPPORT_EMAIL=

# Public storefront URL (invoice links, redirects)
FRONTEND_URL=http://localhost:3000

# One-time hosted bootstrap (used by docker-entrypoint.sh when set).
# Delete both admin variables after the first successful login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Store Owner
BOOTSTRAP_DEMO_DATA=false
